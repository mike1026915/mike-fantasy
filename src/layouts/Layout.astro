---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Sidebar from '../components/Sidebar.astro';

const seo = Astro.props;
---

<html lang="en">
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <div class="page">
      <Sidebar />
      <main class="content">
        <slot />
      </main>
    </div>
    <script is:inline>
      // Netlify Identity invite, recovery and confirmation links land on the site
      // root with a token in the hash. Load the widget only then, so normal visits
      // do not pay for it, and send the user to the CMS once they are logged in.
      if (/(invite|recovery|confirmation|email_change)_token=/.test(window.location.hash)) {
        var identity = document.createElement('script');
        identity.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        identity.onload = function () {
          window.netlifyIdentity.on('login', function () {
            window.location.href = '/admin/';
          });
        };
        document.head.appendChild(identity);
      }
    </script>
  </body>
</html>

<style>
  .page {
    display: flex;
  }

  .content {
    background-color: var(--light-grey);
    min-height: 100vh;
    height: 100%;
    width: 100%;
    padding: 3%;
    transition: all 0.5s ease 0s;
  }

  @media (min-width: 125vh) {
    .content {
      margin-left: calc(var(--side-panel-size) + var(--side-panel-left-padding) + var(--side-panel-right-padding));
    }
  }

  @media (max-width: 125vh) {
    .content {
      margin-left: 50px;
    }
  }
</style>
