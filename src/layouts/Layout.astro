---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import type { Props as SEOProps } from '../components/SEO.astro';
import Sidebar from '../components/Sidebar.astro';

type Props = SEOProps;

const seo = Astro.props;
const { lang = 'en' } = seo;
---

<html lang={lang}>
  <head>
    <SEO {...seo} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to main content
    </a>
    <div class="page">
      <Sidebar />
      <main class="content" id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <script>
      // Netlify Identity invite, recovery and confirmation links land on the site
      // root with a token in the hash. Load the widget only then, so normal visits
      // do not pay for it, and send the user to the CMS once they are logged in.
      if (/(invite|recovery|confirmation|email_change)_token=/.test(window.location.hash)) {
        const identity = document.createElement('script');
        identity.src = 'https://identity.netlify.com/v1/netlify-identity-widget.js';
        identity.onload = () => {
          (
            window as unknown as { netlifyIdentity: { on(event: string, cb: () => void): void } }
          ).netlifyIdentity.on('login', () => {
            window.location.href = '/admin/';
          });
        };
        document.head.appendChild(identity);
      }
    </script>
  </body>
</html>

<style>
  .page {
    display: flex;
  }

  .content {
    outline: none;
    background-color: var(--light-grey);
    min-height: 100vh;
    height: 100%;
    /* Fill the space beside the fixed sidebar; width:100% plus the margin overflowed the viewport. */
    flex: 1;
    min-width: 0;
    box-sizing: border-box;
    padding: 3%;
    transition: all 0.5s ease 0s;
  }

  @media (min-width: 961px) {
    .content {
      margin-left: calc(
        var(--side-panel-size) + var(--side-panel-left-padding) + var(--side-panel-right-padding)
      );
    }
  }

  @media (max-width: 960px) {
    .content {
      padding-top: 8rem;
    }
  }
</style>
