---
import { siteConfig } from '../siteConfig';
import previewImage from '../images/preview.png';
import iconImage from '../images/icon.png';
import appleTouchIcon from '../images/apple-touch-icon.png';

export interface Props {
  /** Page title. Omit on the home page to use the site title as is. */
  title?: string;
  description?: string;
  /** Used for the canonical and og:url, e.g. "/resume/". Omit with `noindex`. */
  pathname?: string;
  /** Keep the page out of search results and skip the canonical. */
  noindex?: boolean;
  ogType?: string;
  /** Absolute URL; falls back to the site preview image. */
  image?: string;
  /** Alt text for `image`. */
  imageAlt?: string;
  /** Language of the page content. Sets <html lang>, og:locale and inLanguage. */
  lang?: 'en' | 'zh-Hant';
  /** Object or array of objects serialised as JSON-LD. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = siteConfig.description,
  pathname,
  noindex = false,
  ogType = 'website',
  image,
  imageAlt,
  lang = 'en',
  jsonLd,
} = Astro.props;

const LOCALES = { en: 'en_US', 'zh-Hant': 'zh_TW' };

const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.title;
const url = pathname ? `${siteConfig.siteUrl}${pathname}` : undefined;
// `<` is escaped so a value such as "</script>" cannot end the JSON-LD block.
// Only the default preview has known dimensions; a custom image is passed through as is.
const usingDefaultImage = !image;
const imageUrl = image ?? `${siteConfig.siteUrl}${previewImage.src}`;
const imageDescription =
  imageAlt ??
  (usingDefaultImage ? `${siteConfig.name}, ${siteConfig.title.split('|')[1]?.trim()}` : pageTitle);
const jsonLdText = jsonLd && JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
{url && !noindex && <link rel="canonical" href={url} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/png" href={iconImage.src} />
<link rel="apple-touch-icon" href={appleTouchIcon.src} />
<meta name="theme-color" content="#6a6e4f" />
<link rel="alternate" type="application/rss+xml" title={siteConfig.name} href="/rss.xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<meta name="description" content={description} />

{url && !noindex && <meta property="og:url" content={url} />}
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageDescription} />
{usingDefaultImage && <meta property="og:image:width" content={String(previewImage.width)} />}
{usingDefaultImage && <meta property="og:image:height" content={String(previewImage.height)} />}
<meta property="og:site_name" content={siteConfig.name} />
<meta property="og:description" content={description} />
<meta property="og:locale" content={LOCALES[lang]} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageDescription} />
<meta name="twitter:site" content={siteConfig.twitter} />
<meta name="twitter:creator" content={siteConfig.twitter} />

{jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
