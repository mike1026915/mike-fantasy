---
import { Image } from 'astro:assets';
import profilePicture from '../images/Mike.jpg';
import { siteConfig } from '../siteConfig';

const { name, intro, menus, contacts } = siteConfig;

const LABELS: Record<string, string> = {
  github: 'Mike on GitHub',
  email: 'Email Mike',
  linkedin: 'Mike on LinkedIn',
  instagram: 'Mike on Instagram',
};

const pathname = Astro.url.pathname;
const isCurrent = (path: string) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path.replace(/\/$/, ''));

