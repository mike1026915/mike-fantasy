---

<aside class="sidebar" data-open="false">
  <div class="switch-bar">
    <button class="switch" type="button" aria-label="Toggle menu" aria-expanded="false">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
        <path d="M15.41 7.41 14 6l-6 6 6 6 1.41-1.41L10.83 12z" />
      </svg>
    </button>
  </div>
  <div class="content">
    <div class="me">
      <div class="avatar">
        <Image src={profilePicture} alt="Mike Picture" title="Mike Fang" width={400} draggable={false} />
      </div>
      <div class="name">{name}</div>
      <q class="intro">{intro}</q>
    </div>

    <nav class="menus">
      {menus.map((menu) => (
        <li>
          <a href={menu.path}>{menu.label}</a>
        </li>
      ))}
    </nav>

    <ul class="contacts">
      {Object.entries(contacts).map(([key, href]) => (
        <li>
          <a href={href} rel="noopener noreferrer" target="_blank">
            <svg viewBox={ICONS[key].viewBox}>
              <title>{key}</title>
              <path d={ICONS[key].path} />
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('.sidebar');
  const toggle = sidebar?.querySelector<HTMLButtonElement>('.switch');

  toggle?.addEventListener('click', () => {
    if (!sidebar) return;
    const open = sidebar.dataset.open !== 'true';
    sidebar.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>

<style>
  .sidebar {
    background-color: var(--dark-green);
    min-height: 100vh;
    transition: all 0.5s ease 0s;
    z-index: 1;
    top: 0;
    left: 0;
    position: fixed;
  }

  .switch-bar {
    padding: 5px;
    min-height: 80px;
    width: 100%;
    display: flex;
    flex-direction: row-reverse;
    box-sizing: border-box;
  }

  .switch {
    visibility: hidden;
    background: none;
    color: var(--grey);
    border: 2px solid var(--grey);
    border-radius: 5px;
    padding: 5px;
    margin: 15px 8px;
    height: fit-content;
    cursor: pointer;
    transition: transform 0.5s ease 0s;
  }

  .switch:hover {
    opacity: 0.7;
  }

  .content {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 1rem;
  }

  .me {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .avatar {
    width: 25vh;
    height: 25vh;
    margin: 0 0 1.5rem 0;
    overflow: hidden;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: rotate(25deg);
  }

  .name {
    font-size: 3rem;
    font-weight: bold;
  }

  .intro {
    font-size: 1rem;
    font-style: italic;
    margin: 0.5rem 25% 0 0;
    line-height: 2.1rem;
    letter-spacing: 0.1rem;
  }

  .intro::before {
    content: '\201C';
  }

  .intro::after {
    content: '\201D';
  }

  .menus {
    padding: 0;
    margin: 0;
  }

  .menus li {
    list-style-type: none;
    font-size: 1.5rem;
    margin: 1rem 0;
    font-family: var(--sans);
  }

  .menus li:hover {
    transform: scale(1.5) translate(15px);
  }

  .contacts {
    padding: 0;
    margin: 0;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 1rem;
  }

  .contacts li {
    list-style-type: none;
    margin: 1rem 0;
  }

  .contacts svg {
    width: 1.5rem;
    height: 1.5rem;
    fill: var(--white);
  }

  .contacts svg:hover {
    opacity: 0.7;
  }

  @media (min-width: 125vh) {
    .sidebar {
      width: var(--side-panel-size);
      padding-left: var(--side-panel-left-padding);
      padding-right: var(--side-panel-right-padding);
    }
  }

  @media (max-width: 125vh) {
    .sidebar {
      width: 50px;
      padding-left: 0;
      padding-right: 0;
    }

    .sidebar .content {
      display: none;
    }

    .switch {
      visibility: visible;
      margin: 8px;
      top: 0;
      left: 0;
      position: fixed;
      transform: rotate(180deg);
    }

    .sidebar[data-open='true'] {
      width: var(--side-panel-size);
      padding-left: var(--side-panel-left-padding);
      padding-right: var(--side-panel-right-padding);
    }

    .sidebar[data-open='true'] .content {
      display: flex;
    }

    .sidebar[data-open='true'] .switch {
      position: static;
      margin: 15px 8px;
      transform: rotate(0);
    }
  }
</style>
