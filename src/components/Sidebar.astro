---

<aside class="sidebar" data-open="false">
  <div class="switch-bar">
    <a class="bar-name" href="/">
      {name}
    </a>
    <button class="switch" type="button" aria-expanded="false" aria-controls="sidebar-content">
      <span>Menu</span>
      <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
        <path d="M7.41 8.59 12 13.17l4.59-4.58L18 10l-6 6-6-6z" />
      </svg>
    </button>
  </div>
  <div class="content" id="sidebar-content">
    <div class="me">
      <a class="home" href="/">
        <div class="avatar">
          <Image src={profilePicture} alt="Portrait of Mike Fang" width={400} draggable={false} />
        </div>
        <div class="name">{name}</div>
      </a>
      <q class="intro">{intro}</q>
    </div>

    <nav class="menus" aria-label="Main">
      <ul>
        {menus.map((menu) => (
          <li>
            <a href={menu.path} aria-current={isCurrent(menu.path) ? 'page' : undefined}>
              {menu.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <ul class="contacts" aria-label="Contact links">
      {Object.entries(contacts)
        .filter(([key]) => ICONS[key])
        .map(([key, href]) => (
          <li>
            <a
              href={href}
              aria-label={LABELS[key] ?? key}
              rel={key === 'email' ? undefined : 'noopener noreferrer'}
              target={key === 'email' ? undefined : '_blank'}
            >
              <svg viewBox={ICONS[key].viewBox} aria-hidden="true" focusable="false">
                <path d={ICONS[key].path} />
              </svg>
            </a>
          </li>
        ))}
    </ul>
  </div>
</aside>

<script>
  const sidebar = document.querySelector<HTMLElement>('.sidebar');
  const toggle = sidebar?.querySelector<HTMLButtonElement>('.switch');

  // The toggle only exists visually on small screens; on desktop the panel is always open.
  const toggleShown = () => !!toggle && getComputedStyle(toggle).visibility !== 'hidden';

  const setOpen = (open: boolean) => {
    if (!sidebar || !toggle) return;
    sidebar.dataset.open = String(open);
    toggle.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => {
    const open = sidebar?.dataset.open !== 'true';
    setOpen(open);
    if (open) sidebar?.querySelector<HTMLElement>('#sidebar-content a')?.focus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || sidebar?.dataset.open !== 'true' || !toggleShown()) return;
    setOpen(false);
    toggle?.focus();
  });
</script>

<style>
  .sidebar {
    background-color: var(--dark-green);
    min-height: 100vh;
    transition: all 0.5s ease 0s;
    z-index: 1;
    top: 0;
    left: 0;
    position: fixed;
  }

  .switch-bar {
    padding: 5px;
    min-height: 80px;
    width: 100%;
    display: flex;
    flex-direction: row-reverse;
    box-sizing: border-box;
  }

  .bar-name {
    display: none;
  }

  .switch {
    visibility: hidden;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    background: none;
    color: var(--white);
    border: 2px solid var(--grey);
    border-radius: 5px;
    padding: 0 1rem;
    font-family: var(--sans);
    font-size: 1.5rem;
    font-weight: 600;
    cursor: pointer;
  }

  .switch svg {
    transition: transform 0.2s ease;
  }

  .switch:hover {
    opacity: 0.7;
  }

  .content {
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    gap: 1rem;
  }

  .me {
    display: flex;
    flex-direction: column;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  .home {
    text-decoration: none;
  }

  .avatar {
    width: 25vh;
    height: 25vh;
    margin: 0 0 1.5rem 0;
    overflow: hidden;
  }

  .avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: rotate(25deg);
  }

  .name {
    font-size: 3.6rem;
    font-weight: bold;
  }

  .intro {
    font-size: 1.5rem;
    font-style: italic;
    margin: 0.5rem 10% 0 0;
    line-height: 2.4rem;
    letter-spacing: 0.05rem;
  }

  .intro::before {
    content: '\201C';
  }

  .intro::after {
    content: '\201D';
  }

  .menus ul {
    padding: 0;
    margin: 0;
  }

  .menus li {
    list-style-type: none;
    font-size: 1.8rem;
    margin: 0;
    font-family: var(--sans);
    font-weight: 600;
  }

  .menus a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    transition: transform 0.2s ease;
    transform-origin: left center;
  }

  .menus a:hover:not([aria-current='page']) {
    transform: translateX(0.8rem);
  }

  .menus a[aria-current='page'] {
    text-decoration-thickness: 0.2rem;
  }

  .contacts {
    padding: 0;
    margin: 0 0 0 -1.3rem;
    width: 100%;
    display: flex;
    justify-content: flex-start;
    gap: 0.2rem;
  }

  .contacts li {
    list-style-type: none;
    margin: 0;
  }

  .contacts a {
    display: flex;
    padding: 1.3rem;
  }

  .contacts svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: var(--white);
  }

  .contacts svg:hover {
    opacity: 0.7;
  }

  @media (min-width: 961px) {
    .sidebar {
      width: var(--side-panel-size);
      padding-left: var(--side-panel-left-padding);
      padding-right: var(--side-panel-right-padding);
    }
  }

  @media (max-width: 960px) {
    /* A labelled top bar instead of a 50px rail, so every page shows the name,
       the menu and (when open) the contacts. */
    .sidebar {
      width: 100%;
      min-height: 0;
      max-height: 100vh;
      overflow-y: auto;
      right: 0;
    }

    .switch-bar {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      min-height: 5.6rem;
      padding: 0 1.2rem;
    }

    .bar-name {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-family: var(--sans);
      font-size: 1.8rem;
      font-weight: 700;
      text-decoration: none;
    }

    .switch {
      visibility: visible;
    }

    .sidebar .content {
      display: none;
      padding: 0 1.5rem 2rem;
      box-sizing: border-box;
    }

    .sidebar[data-open='true'] .content {
      display: flex;
    }

    .sidebar[data-open='true'] .switch svg {
      transform: rotate(180deg);
    }

    .avatar {
      width: 12rem;
      height: 12rem;
    }
  }
</style>
