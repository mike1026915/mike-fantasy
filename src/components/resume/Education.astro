---
import SectionTitle from './SectionTitle.astro';

const { education } = Astro.props;
---

<div class="education">
  <SectionTitle text="Education" />
  <div>
    {education.map((e: any) => (
      <>
        <div class="row">
          <h3 class="degree">{e.degree}</h3>
          <div class="period">
            {e.start} - {e.end}
          </div>
        </div>
        <div class="row">
          <p class="school">
            <a href={e.url}> {e.school} </a>
          </p>
          <p class="location">{e.location}</p>
        </div>
        {e.thesis && (
          <ul>
            <li> Thesis: {e.thesis} </li>
          </ul>
        )}
      </>
    ))}
  </div>
</div>

<style>
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .education {
    margin-top: 3rem;
  }

  .degree {
    flex: 1;
    font-weight: 600;
    margin-top: 1.6rem;
  }

  .row + .row {
    margin-top: 0.4rem;
  }

  ul {
    margin: 0.4rem 0 0;
    padding-left: 2rem;
  }

  li {
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
    color: #2b2f33;
  }

  .school {
    font-size: 1.75rem;
    font-weight: 300;
    font-family: var(--sans);
    letter-spacing: normal;
    padding-bottom: 0;
  }

  .period {
    flex: none;
    margin-left: 1.5rem;
    white-space: nowrap;
  }

  .period,
  .location {
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 300;
    font-family: var(--sans);
    letter-spacing: normal;
    padding-bottom: 0;
  }
</style>
