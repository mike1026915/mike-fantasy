---
import SectionTitle from './SectionTitle.astro';

const { education } = Astro.props;
---

<SectionTitle text="Education" />
<div>
  {education.map((e: any) => (
    <>
      <div class="row">
        <h3 class="degree">{e.degree}</h3>
        <div class="period">
          {e.start} - {e.end}
        </div>
      </div>
      <div class="row">
        <p class="school">
          <a href={e.url}> {e.school} </a>
        </p>
        <p class="location">{e.location}</p>
      </div>
      {e.thesis && (
        <ul>
          <li> Thesis: {e.thesis} </li>
        </ul>
      )}
    </>
  ))}
</div>

<style>
  .row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .degree {
    text-decoration: underline;
  }

  .school {
    font-size: 2rem;
    font-weight: 300;
    font-family: var(--sans);
    letter-spacing: normal;
    padding-bottom: 0;
  }

  .period,
  .location {
    font-style: italic;
    font-size: 1.5rem;
    font-weight: 300;
    font-family: var(--sans);
    letter-spacing: normal;
    padding-bottom: 0;
  }
</style>
