---
import ContactButtons from '../brand/ContactButtons.astro';

const { name, chineseName, title, contacts } = Astro.props;

const ICONS: Record<string, { path: string; viewBox: string }> = {
  linkedin: {
    path: 'M4.98 3.5c0 1.381-1.11 2.5-2.48 2.5s-2.48-1.119-2.48-2.5c0-1.38 1.11-2.5 2.48-2.5s2.48 1.12 2.48 2.5zm.02 4.5h-5v16h5v-16zm7.982 0h-4.968v16h4.969v-8.399c0-4.67 6.029-5.052 6.029 0v8.399h4.988v-10.131c0-7.88-8.922-7.593-11.018-3.714v-2.155z',
    viewBox: '-1 -0.5 26 26',
  },
  github: {
    path: 'M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3',
    viewBox: '-1 -1 26 26',
  },
  email: {
    path: 'M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z',
    viewBox: '1 1 22 22',
  },
  website: {
    path: 'M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm-5 14H4v-4h11v4zm0-5H4V9h11v4zm5 5h-4V9h4v9z',
    viewBox: '1 1 22 22',
  },
  location: {
    path: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z',
    viewBox: '1 1 22 22',
  },
};
---

<header>
  <div class="left">
    <h1>
      <span lang="zh-Hant">{chineseName}</span> {name}
    </h1>
    <p class="role">{title}</p>
    <ContactButtons contacts={contacts} />
  </div>
  <div class="right">
    {Object.entries(contacts).map(([key, contact]: [string, any]) => (
      <div class="contact">
        {ICONS[key] && (
          <svg
            viewBox={ICONS[key].viewBox}
            width="24"
            height="24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d={ICONS[key].path} />
          </svg>
        )}
        <a href={contact.link} target="_blank" rel="noopener noreferrer">
          {contact.text}
        </a>
      </div>
    ))}
  </div>
</header>

<style>
  header {
    display: flex;
    justify-content: space-between;
    border-bottom: 0.2rem solid var(--light-green);
    padding-bottom: 2rem;
  }

  h1 {
    margin-bottom: 1rem;
  }

  .left {
    width: 66.67%;
  }

  /* A tagline, not a heading: keeps the h1 -> h2 outline intact. */
  .role {
    margin-bottom: 1.5rem;
    font-family: var(--sans);
    font-size: 2.34rem;
    font-weight: 300;
    letter-spacing: normal;
    padding-bottom: 0;
  }

  .contact {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-bottom: 0.4rem;
  }

  .contact svg {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
  }

  @media (min-width: 961px) {
    .right {
      width: 33.33%;
      display: flex;
      flex-direction: column;
      justify-items: space-between;
      border-left: 0.2rem solid var(--light-green);
      padding-left: 1.5rem;
      padding-bottom: 0.5rem;
      padding-top: 1rem;
    }

    .right a {
      font-size: 1.5rem;
    }
  }

  /* Contact details stay visible on small screens; they are the point of the page. */
  @media (max-width: 960px) {
    header {
      flex-direction: column;
    }

    .left {
      width: 100%;
    }

    .right {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 2.5rem;
      padding-top: 1.5rem;
    }

    .right a {
      font-size: 1.5rem;
    }
  }
</style>
