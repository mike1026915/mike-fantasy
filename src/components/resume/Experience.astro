---
import SectionTitle from './SectionTitle.astro';
import { inlineMarkup } from '../../lib/text';

const { experience } = Astro.props;

// Lets the home page deep-link to a role; keep in sync with SelectedWork.astro.
const anchor = (company: string, role: string) =>
  `${company} ${role}`
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<SectionTitle text="Experience" />
<div>
  {experience.map((e: any) => {
    const sections = e.sections ?? [];
    const events = e.events ?? [];

    return (
      <>
        <div class="row" id={anchor(e.company, e.role)}>
          <h3 class="role">{e.role}</h3>
          <div class="period">
            {e.start} - {e.end}
          </div>
        </div>
        <div class="row">
          <h4>{e.company}</h4>
          <h4 class="location">{e.location}</h4>
        </div>
        <div>
          {e.project && <a href={e.url}>{e.project}</a>}
          {e.description &&
            (sections.length > 0 ? (
              <p class="lead">{e.description}</p>
            ) : (
              <>
                <br />
                {e.description}
              </>
            ))}
        </div>
        {sections.length > 0 ? (
          sections.map((section: any) => (
            <div>
              <h4 class="section-heading">{section.title}</h4>
              <ul class="events sections">
                {section.events.map((event: string) => (
                  <li set:html={inlineMarkup(event)} />
                ))}
              </ul>
            </div>
          ))
        ) : (
          <ul class="events">
            {events.map((event: string) => (
              <li set:html={inlineMarkup(event)} />
            ))}
          </ul>
        )}
      </>
    );
  })}
</div>

<style>
  .row {
    scroll-margin-top: 2rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
  }

  .role {
    text-decoration: underline;
    margin-top: 1.6rem;
  }

  .row + .row {
    margin-top: 0.4rem;
  }

  .row + div > a {
    display: inline-block;
    margin-top: 0.6rem;
  }

  .period,
  .location {
    font-style: italic;
    font-size: 1.5rem;
  }

  .lead {
    margin: 0.8rem 0 0;
    line-height: 1.7;
    font-style: italic;
    font-weight: 400;
  }

  .events {
    margin: 0.4rem 0 0;
    padding-left: 2rem;
  }

  .events :global(li) {
    font-weight: 400;
    letter-spacing: 0;
    line-height: 1.6;
    padding-bottom: 0.6rem;
    color: #2b2f33;
  }

  .sections :global(strong) {
    font-weight: 700;
  }

  .section-heading {
    margin: 1.6rem 0 0.2rem;
    font-family: var(--body);
    font-size: 1.75rem;
    font-style: normal;
    font-weight: 700;
  }
</style>
