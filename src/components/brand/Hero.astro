---
const { name, chineseName, title, line } = Astro.props;
---

<header>
  <h1>
    <span lang="zh-Hant">{chineseName}</span> {name}
  </h1>
  <h3>{title}</h3>
  <p>{line}</p>
</header>

<style>
  header {
    border-bottom: 0.2rem solid var(--light-green);
    padding-bottom: 2rem;
  }

  h1 {
    margin-bottom: 0.5rem;
  }

  h3 {
    margin-bottom: 1.5rem;
  }

  p {
    font-size: 2.4rem;
    line-height: 1.5;
    font-weight: 400;
    max-width: 80rem;
  }
</style>
