---
import SectionTitle from '../resume/SectionTitle.astro';

const { work } = Astro.props;

// Same slug as the id Experience.astro puts on each role on /resume/.
const anchor = (company: string, role: string) =>
  `${company} ${role}`
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-|-$/g, '');
---

<SectionTitle text="Selected Work" />
<div class="grid">
  {work.map((item: any) => (
    <article>
      <div class="domain">{item.domain}</div>
      <h3>{item.name}</h3>
      <div class="meta">
        {item.role}, {item.company}
      </div>
      <p>{item.summary}</p>
      <a
        href={`/resume/#${anchor(item.company, item.role)}`}
        aria-label={`Read more about ${item.name} in resume`}
      >
        Read more in resume
      </a>
    </article>
  ))}
</div>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  article {
    background: var(--white);
    padding: 2rem;
    border-top: 0.4rem solid var(--dark-green);
  }

  /* The lead story spans the row; the other three share one row beneath it. */
  article:first-child {
    grid-column: 1 / -1;
    border-top-width: 0.8rem;
  }

  article:first-child h3 {
    font-size: 3rem;
  }

  article p {
    font-weight: 400;
    line-height: 1.6;
    max-width: 76rem;
  }

  .domain {
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    color: var(--dark-green);
  }

  h3 {
    font-weight: 500;
    margin: 0.5rem 0;
  }

  .meta {
    font-size: 1.5rem;
    font-style: italic;
    margin-bottom: 1rem;
  }

  a {
    display: inline-block;
    margin-top: 1rem;
    font-size: 1.5rem;
    color: var(--dark-green);
  }

  @media (min-width: 1280px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
