---
const { proofPoints } = Astro.props;
---

<ul>
  {proofPoints.map((point: any) => (
    <li>
      <div class="value">{point.value}</div>
      {point.text}
      <div class="domain">{point.domain}</div>
      {point.context && <div class="context">{point.context}</div>}
    </li>
  ))}
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin: 2.5rem 0;
    padding: 0;
  }

  li {
    list-style-type: none;
    flex: 1 1 24rem;
    padding: 0 0 0 1.5rem;
    border-left: 0.4rem solid var(--light-green);
    font-weight: 400;
  }

  .value {
    font-family: var(--sans);
    font-size: clamp(4rem, 6vw, 5.6rem);
    font-weight: 700;
    line-height: 1.1;
    color: color-mix(in srgb, var(--dark-green) 70%, black);
  }

  .domain {
    font-size: 1.3rem;
    text-transform: uppercase;
    letter-spacing: 0.1rem;
    margin-top: 0.5rem;
  }

  .context {
    font-size: 1.5rem;
    margin-top: 0.3rem;
    color: var(--black);
  }
</style>
