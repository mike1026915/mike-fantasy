---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../siteConfig';
import { formatDate, readingMinutes } from '../../lib/text';
import { resolveSocialImage } from '../../lib/social';
import { getPublishedPosts } from '../../lib/posts';
import ContactLine from '../../components/brand/ContactLine.astro';
import profile from '../../data/profile.json';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  // Sorted newest first: the neighbour at index + 1 is the older post.
  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      previous: posts[index + 1]?.data,
      next: posts[index - 1]?.data,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { title, description, date, slug, tags, socialImage, lang } = post.data;
const image = resolveSocialImage(socialImage);
const { Content } = await render(post);
const url = `${siteConfig.siteUrl}/blogs/${slug}/`;
---

<Layout
  title={title}
  description={description}
  pathname={`/blogs/${slug}/`}
  ogType="article"
  lang={lang}
  image={image}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    keywords: tags,
    inLanguage: lang,
    url,
    ...(image && { image }),
    author: { '@type': 'Person', name: siteConfig.name, url: siteConfig.siteUrl },
  }}
>
  <a class="back" href="/blogs/">
    ← Blog
  </a>
  <h1>{title}</h1>
  <p class="metadata">
    <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingMinutes(post.body)} min
    read
  </p>

  <div class="prose" lang={lang}>
    <Content />
  </div>
  <hr />
  <nav class="pager">
    <div>
      {previous && (
        <a href={`/blogs/${previous.slug}/`} rel="prev">
          ← {previous.title}
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={`/blogs/${next.slug}/`} rel="next">
          {next.title} →
        </a>
      )}
    </div>
  </nav>
  <ContactLine contacts={profile.contacts} />
</Layout>

<style>
  .back {
    display: inline-block;
    margin-bottom: 1rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.05rem;
    text-transform: uppercase;
    color: var(--dark-green);
    text-decoration: none;
  }

  .back:hover {
    text-decoration: underline;
  }

  .metadata {
    border-bottom: 0.2rem solid var(--light-green);
    padding: 1rem 0;
    margin-bottom: 1.5rem;
    font-weight: 400;
  }

  /* Cap the measure so long posts stay readable on wide screens. */
  .prose {
    max-width: 76rem;
  }

  .prose :global(p),
  .prose :global(li) {
    font-weight: 400;
    line-height: 1.7;
    padding-bottom: 1rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
