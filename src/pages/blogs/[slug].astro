---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { siteConfig } from '../../siteConfig';
import { formatDate, readingMinutes } from '../../lib/text';
import { resolveSocialImage } from '../../lib/social';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );

  // Sorted newest first: the neighbour at index + 1 is the older post.
  return posts.map((post, index) => ({
    params: { slug: post.data.slug },
    props: {
      post,
      previous: posts[index + 1]?.data,
      next: posts[index - 1]?.data,
    },
  }));
}

const { post, previous, next } = Astro.props;
const { title, description, date, slug, tags, socialImage, lang } = post.data;
const image = resolveSocialImage(socialImage);
const { Content } = await render(post);
const url = `${siteConfig.siteUrl}/blogs/${slug}/`;
---

<Layout
  title={title}
  description={description}
  pathname={`/blogs/${slug}/`}
  ogType="article"
  lang={lang}
  image={image}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: title,
    description,
    datePublished: date.toISOString(),
    keywords: tags,
    inLanguage: lang,
    url,
    ...(image && { image }),
    author: { '@type': 'Person', name: siteConfig.name, url: siteConfig.siteUrl },
  }}
>
  <h1>{title}</h1>
  <div class="metadata">
    <p>{formatDate(date)},</p>
    <p>&nbsp;{readingMinutes(post.body)} minute to read</p>
  </div>

  <div lang={lang}>
    <Content />
  </div>
  <hr />
  <nav class="pager">
    <div>
      {previous && (
        <a href={`/blogs/${previous.slug}/`} rel="prev">
          ← {previous.title}
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={`/blogs/${next.slug}/`} rel="next">
          {next.title} →
        </a>
      )}
    </div>
  </nav>
</Layout>

<style>
  .metadata {
    display: flex;
    border-bottom: solid;
    padding-top: 1rem;
    padding-bottom: 1rem;
    margin-bottom: 1.5rem;
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
</style>
