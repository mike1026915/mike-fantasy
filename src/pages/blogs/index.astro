---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostTitle from '../../components/blog/PostTitle.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout
  title="Blog"
  description="Notes from Mike Fang on software engineering, building products, and leading teams."
  pathname="/blogs/"
>
  <h1 class="heading">{`LOGGER.INFO({ Mike })`}</h1>
  <div class="posts">
    {posts.length > 0
      ? posts.map((post) => <PostTitle post={post} />)
      : <p>No posts published yet. Writing is on the way.</p>}
  </div>
</Layout>

<style>
  .heading {
    word-spacing: 1rem;
    display: flex;
    border-bottom: 0.2rem solid var(--light-green);
    padding-bottom: 1.5rem;
    margin-bottom: 1rem;
  }

  .posts {
    margin-top: 1.5rem;
  }
</style>
