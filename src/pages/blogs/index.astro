---
import Layout from '../../layouts/Layout.astro';
import PostTitle from '../../components/blog/PostTitle.astro';
import ContactLine from '../../components/brand/ContactLine.astro';
import profile from '../../data/profile.json';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Blog"
  description="Notes from Mike Fang on software engineering, building products, and leading teams."
  pathname="/blogs/"
>
  <h1 class="heading">{`LOGGER.INFO({ Mike })`}</h1>
  <div class="posts">
    {posts.length > 0 ? (
      posts.map((post) => <PostTitle post={post} />)
    ) : (
      <p>No posts published yet. Writing is on the way.</p>
    )}
  </div>
  <ContactLine contacts={profile.contacts} />
</Layout>

<style>
  .heading {
    word-spacing: 1rem;
    overflow-wrap: anywhere;
    border-bottom: 0.2rem solid var(--light-green);
    padding-bottom: 1.5rem;
    margin-bottom: 1rem;
  }

  .posts {
    margin-top: 1.5rem;
  }
</style>
