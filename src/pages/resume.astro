---
import Layout from '../layouts/Layout.astro';
import Header from '../components/resume/Header.astro';
import Summary from '../components/resume/Summary.astro';
import Skills from '../components/resume/Skills.astro';
import Hobby from '../components/resume/Hobby.astro';
import Experience from '../components/resume/Experience.astro';
import Education from '../components/resume/Education.astro';
import ContactLine from '../components/brand/ContactLine.astro';
import resume from '../data/profile.json';
import { buildPersonSchema } from '../lib/schema';
---

<Layout
  title="Resume"
  description="Resume of Mike Fang: experience leading full-stack products and teams across HR tech, SaaS, AdTech, and cybersecurity."
  pathname="/resume/"
  ogType="profile"
  jsonLd={buildPersonSchema(resume.title, resume.chineseName)}
>
  <Header
    name={resume.name}
    chineseName={resume.chineseName}
    title={resume.title}
    contacts={resume.contacts}
  />
  <nav class="jump" aria-label="On this page">
    <a href="#experience">Experience</a>
    <a href="#education">Education</a>
    <a href="#skills">Skills</a>
    <a href="#hobby">Hobby</a>
  </nav>
  <Summary summary={resume.summary} highlights={resume.summaryHighlights} />
  <div class="columns">
    <div class="left">
      <Experience experience={resume.experience} />
      <Education education={resume.education} />
    </div>
    <div class="right">
      <Skills skills={resume.skills} />
      <Hobby hobby={resume.hobby} />
    </div>
  </div>
  <ContactLine contacts={resume.contacts} resume="pdf" />
</Layout>

<style>
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0 2.5rem;
    padding-top: 0.5rem;
  }

  .jump a {
    display: inline-block;
    padding: 1.1rem 0;
    font-family: var(--sans);
    font-size: 1.5rem;
    font-weight: 600;
  }

  .columns {
    display: flex;
  }

  @media (min-width: 961px) {
    .columns {
      flex-direction: row;
    }

    .left {
      width: 66.67%;
      min-height: 100px;
      padding: 1.5rem 3.1rem 0 0;
    }

    .right {
      width: 33.33%;
      min-height: 100px;
      border-left: 0.2rem solid var(--light-green);
      padding: 1.5rem 0 0 2.5rem;
    }
  }

  @media (max-width: 960px) {
    .columns {
      flex-direction: column;
    }

    .left,
    .right {
      width: 100%;
      min-height: 100px;
      padding: 1.5rem 0 0;
    }
  }
</style>
