---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/brand/Hero.astro';
import ProofPoints from '../components/brand/ProofPoints.astro';
import SelectedWork from '../components/brand/SelectedWork.astro';
import ContactLine from '../components/brand/ContactLine.astro';
import resume from '../data/profile.json';
import { buildPersonSchema } from '../lib/schema';

const { brand } = resume;
---

<Layout pathname="/" ogType="profile" jsonLd={buildPersonSchema(brand.title, resume.chineseName)}>
  <Hero
    name={resume.name}
    chineseName={resume.chineseName}
    title={brand.title}
    line={brand.line}
    contacts={resume.contacts}
  />
  <ProofPoints proofPoints={brand.proofPoints} />
  <SelectedWork work={brand.selectedWork} />
  <ContactLine contacts={resume.contacts} />
</Layout>
